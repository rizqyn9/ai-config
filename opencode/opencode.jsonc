{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "model": "9r/free-coding",
  "shell": "zsh",
  "formatter": true,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
    "buffer": "15%",
  },
  "experimental": {
    "todo": true,
  },
  "providers": {
    "9r": {
      "name": "9Router",
      "env": [
        "AI_9ROUTER"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{file:~/.secrets/9router-key}",
      },
      "models": {
        "free-coding": {
          "name": "9R · Free first",
          "limit": {
            "context": 128000,
            "output": 32000,
          },
        },
        "thb-free": {
          "name": "9R · THB free",
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "daily-coding": {
          "name": "9R · Daily",
          "limit": {
            "context": 128000,
            "output": 32000,
          },
        },
        "fast-cheap": {
          "name": "9R · Fast & cheap",
          "limit": {
            "context": 128000,
            "output": 32000,
          },
        },
        "reasoning-coding": {
          "name": "9R · Reasoning",
          "limit": {
            "context": 128000,
            "output": 32000,
          },
        },
        "vision-coding": {
          "name": "9R · Vision",
          "limit": {
            "context": 128000,
            "output": 64000,
          },
        },
      },
    },
    "sp": {
      "name": "Sumopod Rdev",
      "env": [
        "AI_SUMAPOD_RDEV"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.sumopod.com/v1",
      },
      "models": {
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4 5",
          "limit": {
            "context": 200000
          },
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5 5",
          "limit": {
            "context": 1000000
          }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4 8",
